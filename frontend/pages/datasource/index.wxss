.page {
  padding-bottom: 60rpx;
}

.notice {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: var(--c-primary-soft);
  font-size: 21rpx;
  line-height: 1.75;
  color: #9c4a4d;
}

.ds__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ds__title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.ds__name {
  font-size: 31rpx;
  font-weight: 600;
}

.ds__switch {
  transform: scale(0.82);
  transform-origin: right center;
  margin-top: -6rpx;
}

.ds__code {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}

.ds__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--c-text-2);
}

.ds__stats {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #f8f9fa;
}

.ds__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ds__stat-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text);
  font-variant-numeric: tabular-nums;
}

.ds__stat-label {
  font-size: 19rpx;
  color: var(--c-text-3);
}

.ds__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.ds__btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #f2f3f5;
  font-size: 23rpx;
  color: var(--c-text-2);
}

.ds__btn--primary {
  background: var(--c-primary);
  color: #fff;
}

.ds__btn--danger {
  background: #fbedee;
  color: var(--c-primary);
}

.ds__btn:active {
  opacity: 0.75;
}

.foot-note {
  margin: 24rpx 32rpx 0;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--c-text-3);
}
