<view class="page home-page">
  <view class="home-head">
    <view class="home-head__titles">
      <view class="home-head__title">我的自选</view>
      <view class="home-head__time">行情时间 {{quoteTimeText}}</view>
    </view>
    <view class="home-head__actions">
      <text class="head-action" bindtap="onRefreshQuotes">{{refreshingQuotes ? '提交中' : '刷新'}}</text>
      <text class="head-action head-action--primary" bindtap="goSearch">添加股票</text>
    </view>
  </view>

  <view wx:if="{{rows.length}}" class="board-meta">
    <text>{{count}} 只自选</text>
    <view class="connection connection--{{connectionTone}}">
      <view class="connection__dot"></view>
      <text>{{connectionText}}</text>
    </view>
  </view>

  <view wx:if="{{loading && !rows.length}}" class="card loading-wrap home-state">
    <view class="spinner"></view>
    <text>看板加载中…</text>
  </view>

  <!-- 十列横滚表格：表头与表体同处一个滚动容器，首列 sticky left、表头 sticky top（design §7.1） -->
  <view wx:elif="{{rows.length}}" class="board-shell">
    <scroll-view class="board-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
      <view class="board-table">
        <view class="board-head">
          <view class="cell cell--stock cell--head">股票 / 代码</view>
          <view
            wx:for="{{columns}}"
            wx:for-item="col"
            wx:key="key"
            class="cell cell--head {{col.cls}}"
          >{{col.label}}</view>
        </view>

        <block wx:for="{{rows}}" wx:for-item="row" wx:key="code">
          <view
            class="board-row {{expandedMap[row.code] ? 'board-row--expanded' : ''}}"
            data-code="{{row.code}}"
            bindtap="toggleTargets"
            hover-class="board-row--hover"
            hover-stay-time="50"
          >
            <view class="cell cell--stock">
              <view class="stock-main" data-code="{{row.code}}" data-name="{{row.name}}" catchtap="goDetail">
                <view class="stock-name ellipsis">{{row.name}}</view>
                <view class="stock-meta ellipsis">
                  <text>{{row.code}}</text>
                  <text wx:if="{{row.exchange}}"> · {{row.exchange}}</text>
                </view>
                <view class="stock-industry ellipsis">{{row.industryText}}</view>
              </view>
              <view class="stock-side">
                <text wx:if="{{row.statusText}}" class="stock-status">{{row.statusText}}</text>
                <text class="stock-arrow {{expandedMap[row.code] ? 'stock-arrow--open' : ''}}">›</text>
              </view>
            </view>
            <view
              wx:for="{{row.cells}}"
              wx:for-item="cell"
              wx:key="key"
              class="cell t-num {{cell.cls}} {{cell.tone}} {{cell.emphasis ? 'cell--emphasis' : ''}}"
            >{{cell.text}}</view>
          </view>

          <view wx:if="{{expandedMap[row.code]}}" class="target-panel">
            <view class="target-panel__head">
              <text>六档目标价</text>
              <text class="target-panel__hint">股息率越高，对应买入价越低</text>
            </view>
            <view class="target-grid">
              <view
                wx:for="{{row.targets}}"
                wx:for-item="target"
                wx:key="key"
                class="target-item {{target.reached ? 'target-item--reached' : ''}}"
              >
                <text class="target-item__label">{{target.label}} 股息率</text>
                <text class="target-item__value t-num">{{target.text}}</text>
                <text wx:if="{{target.reached}}" class="target-item__flag">已达标</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
    <view class="board-foot">左右滑动查看 60周 / 120周 / 周上 / 周中 / 周下 · 点击行展开六档目标价 · 红色底纹表示现价已达目标 · -- 表示数据缺失</view>
  </view>

  <view wx:elif="{{loadFailed}}" class="card home-state load-failed">
    <view class="t-section">看板暂时无法加载</view>
    <view class="t-hint load-failed__hint">请检查后端服务与网络连接，已有数据不会被空值覆盖。</view>
    <button class="btn btn--primary btn--sm" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:else class="card home-state">
    <empty-state
      icon="+"
      text="还没有自选股"
      hint="搜索并添加 A 股后，可在这里查看实时股息率、PE、周线价位与六档目标价"
      action-text="添加股票"
      bind:action="goSearch"
    />
  </view>
</view>
