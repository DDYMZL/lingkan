<view class="page home-page">
  <view class="home-head">
    <view class="home-head__titles">
      <view class="home-head__title">我的自选</view>
      <view class="home-head__time">行情时间 {{quoteTimeText}}</view>
    </view>
    <view class="home-head__actions">
      <text class="head-action" bindtap="onRefreshQuotes">{{refreshingQuotes ? '提交中' : '刷新'}}</text>
      <text class="head-action head-action--primary" bindtap="goSearch">添加股票</text>
    </view>
  </view>

  <view wx:if="{{rows.length}}" class="board-meta">
    <text>{{count}} 只自选</text>
    <view class="connection connection--{{connectionTone}}">
      <view class="connection__dot"></view>
      <text>{{connectionText}}</text>
    </view>
  </view>

  <view wx:if="{{loading && !rows.length}}" class="card loading-wrap home-state">
    <view class="spinner"></view>
    <text>看板加载中…</text>
  </view>

  <view wx:elif="{{rows.length}}" class="board-shell">
    <view class="board-head">
      <view class="stock-cell board-cell--head">股票 / 代码</view>
      <view class="metrics-row metrics-row--head">
        <view class="metric-cell metric-cell--price board-cell--head">现价</view>
        <view class="metric-cell metric-cell--change board-cell--head">涨跌幅</view>
        <view class="metric-cell metric-cell--yield board-cell--head">股息率 TTM</view>
        <view class="metric-cell metric-cell--pe board-cell--head">PE TTM</view>
      </view>
    </view>

    <scroll-view class="board-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="board-content">
        <view wx:for="{{rows}}" wx:for-item="row" wx:key="code" class="board-row">
          <view
            class="board-main {{expandedMap[row.code] ? 'board-main--expanded' : ''}}"
            data-code="{{row.code}}"
            bindtap="toggleTargets"
            hover-class="board-main--hover"
            hover-stay-time="50"
          >
            <view class="stock-cell stock-cell--body">
              <view class="stock-cell__link" data-code="{{row.code}}" catchtap="goDetail">
                <view class="stock-cell__name ellipsis">{{row.name}}</view>
                <view class="stock-cell__meta">
                  <text>{{row.code}}</text>
                  <text wx:if="{{row.exchange}}"> · {{row.exchange}}</text>
                </view>
                <view class="stock-cell__industry ellipsis">{{row.industryText}}</view>
                <text wx:if="{{row.statusText}}" class="stock-cell__status">{{row.statusText}}</text>
              </view>
              <text class="stock-cell__arrow {{expandedMap[row.code] ? 'stock-cell__arrow--open' : ''}}">›</text>
            </view>
            <view class="metrics-row metrics-row--body">
              <view class="metric-cell metric-cell--price t-num {{row.tone}}">{{row.priceText}}</view>
              <view class="metric-cell metric-cell--change t-num {{row.tone}}">{{row.changeText}}</view>
              <view class="metric-cell metric-cell--yield metric-cell--emphasis t-num">{{row.yieldText}}</view>
              <view class="metric-cell metric-cell--pe t-num {{row.peLoss ? 'down' : ''}}">{{row.peText}}</view>
            </view>
          </view>

          <view wx:if="{{expandedMap[row.code]}}" class="target-panel">
            <view class="target-panel__head">
              <text>六档目标价</text>
              <text class="target-panel__hint">股息率越高，对应买入价越低</text>
            </view>
            <view class="target-grid">
              <view
                wx:for="{{row.targets}}"
                wx:for-item="target"
                wx:key="key"
                class="target-item {{target.reached ? 'target-item--reached' : ''}}"
              >
                <text class="target-item__label">{{target.label}} 股息率</text>
                <text class="target-item__value t-num">{{target.text}}</text>
                <text wx:if="{{target.reached}}" class="target-item__flag">已达标</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="board-foot">点击行展开六档目标价 · 红色底纹表示现价已达目标 · -- 表示数据缺失</view>
  </view>

  <view wx:elif="{{loadFailed}}" class="card home-state load-failed">
    <view class="t-section">看板暂时无法加载</view>
    <view class="t-hint load-failed__hint">请检查后端服务与网络连接，已有数据不会被空值覆盖。</view>
    <button class="btn btn--primary btn--sm" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:else class="card home-state">
    <empty-state
      icon="+"
      text="还没有自选股"
      hint="搜索并添加 A 股后，可在这里查看实时股息率、PE 与六档目标价"
      action-text="添加股票"
      bind:action="goSearch"
    />
  </view>
</view>
