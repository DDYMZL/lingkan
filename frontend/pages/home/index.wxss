.home-page {
  padding-top: 24rpx;
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 24rpx;
  padding: 4rpx 4rpx 20rpx;
}

.home-head__titles {
  min-width: 0;
}

.home-head__title {
  font-size: 36rpx;
  font-weight: 600;
}

.home-head__time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}

.home-head__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.head-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 28rpx;
  background: var(--c-card);
  color: var(--c-text-2);
  font-size: 22rpx;
}

.head-action--primary {
  border-color: var(--c-primary);
  background: var(--c-primary);
  color: #fff;
}

.head-action:active {
  opacity: 0.7;
}

.board-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 14rpx;
  color: var(--c-text-3);
  font-size: 22rpx;
}

.connection {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.connection__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-text-3);
}

.connection--ok {
  color: #0f7a4a;
}

.connection--ok .connection__dot {
  background: #0f9757;
}

.connection--warn {
  color: #9a6212;
}

.connection--warn .connection__dot {
  background: #c68a27;
}

.home-state {
  margin: 0 24rpx;
}

.board-shell {
  margin: 0 12rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--c-card);
  box-shadow: 0 2rpx 12rpx rgba(23, 24, 26, 0.04);
}

.board-head,
.board-main {
  display: flex;
  width: 100%;
}

.board-head {
  height: 78rpx;
  border-bottom: 1rpx solid var(--c-line);
  background: #fafbfc;
}

.board-body {
  height: calc(100vh - 254rpx);
  min-height: 480rpx;
}

.board-content,
.board-row {
  width: 100%;
}

.board-row {
  border-bottom: 1rpx solid var(--c-line);
  background: var(--c-card);
}

.board-row:last-child {
  border-bottom: none;
}

.board-main {
  min-height: 112rpx;
  transition: background-color 0.15s ease;
}

.board-main--hover {
  background: #f7f8fa;
}

.board-main--expanded {
  background: #fffdfb;
}

.board-cell--head {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-text-2);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
}

.stock-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  width: 190rpx;
  padding: 0 14rpx 0 18rpx;
}

.board-head .stock-cell {
  justify-content: flex-start;
  padding-left: 20rpx;
}

.stock-cell__link {
  flex: 1;
  min-width: 0;
  padding: 12rpx 0;
}

.stock-cell__name {
  max-width: 132rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.stock-cell__meta {
  margin-top: 7rpx;
  color: var(--c-text-3);
  font-size: 19rpx;
  font-variant-numeric: tabular-nums;
}

.stock-cell__status {
  display: block;
  margin-top: 5rpx;
  color: #9a6212;
  font-size: 18rpx;
}

.stock-cell__arrow {
  flex-shrink: 0;
  margin-left: 4rpx;
  color: var(--c-text-3);
  font-size: 32rpx;
  line-height: 1;
  transform: rotate(90deg);
  transition: transform 0.15s ease;
}

.stock-cell__arrow--open {
  transform: rotate(-90deg);
}

.metrics-row {
  display: flex;
  align-items: stretch;
  flex: 1;
  min-width: 0;
}

.metrics-row--head {
  height: 78rpx;
}

.metrics-row--body {
  min-height: 112rpx;
}

.metric-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0 6rpx;
  color: var(--c-text);
  font-size: 25rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.metric-cell--price {
  width: 125rpx;
}

.metric-cell--change {
  width: 130rpx;
}

.metric-cell--yield {
  width: 160rpx;
}

.metric-cell--pe {
  width: 121rpx;
}

.metric-cell--emphasis {
  color: var(--c-primary);
  font-weight: 600;
}

.target-panel {
  padding: 20rpx;
  border-top: 1rpx solid #f3e9e9;
  background: #fffdfb;
}

.target-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  color: var(--c-text-2);
  font-size: 22rpx;
  font-weight: 500;
}

.target-panel__hint {
  color: var(--c-text-3);
  font-size: 18rpx;
  font-weight: 400;
}

.target-grid {
  display: flex;
  flex-wrap: wrap;
}

.target-item {
  width: 31.333%;
  min-height: 116rpx;
  margin: 0 1% 12rpx;
  padding: 14rpx 8rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 12rpx;
  background: var(--c-card);
  text-align: center;
}

.target-item__label,
.target-item__value,
.target-item__flag {
  display: block;
}

.target-item__label {
  color: var(--c-text-3);
  font-size: 19rpx;
}

.target-item__value {
  margin-top: 7rpx;
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 600;
}

.target-item__flag {
  margin-top: 3rpx;
  color: var(--c-primary);
  font-size: 17rpx;
}

.target-item--reached {
  border-color: #efcfd1;
  background: var(--c-primary-soft);
}

.target-item--reached .target-item__label,
.target-item--reached .target-item__value {
  color: var(--c-primary);
}

.board-foot {
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--c-line);
  color: var(--c-text-3);
  font-size: 19rpx;
  line-height: 1.5;
}

.load-failed {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 64rpx;
  padding-bottom: 64rpx;
  text-align: center;
}

.load-failed__hint {
  margin: 16rpx 0 28rpx;
  line-height: 1.7;
}
