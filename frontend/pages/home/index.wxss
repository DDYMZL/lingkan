.home-page {
  padding-top: 24rpx;
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 24rpx;
  padding: 4rpx 4rpx 20rpx;
}

.home-head__titles {
  min-width: 0;
}

.home-head__title {
  font-size: 36rpx;
  font-weight: 600;
}

.home-head__time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}

.home-head__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.head-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 28rpx;
  background: var(--c-card);
  color: var(--c-text-2);
  font-size: 22rpx;
}

.head-action--primary {
  border-color: var(--c-primary);
  background: var(--c-primary);
  color: #fff;
}

.head-action:active {
  opacity: 0.7;
}

.board-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 14rpx;
  color: var(--c-text-3);
  font-size: 22rpx;
}

.connection {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.connection__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-text-3);
}

.connection--ok {
  color: #0f7a4a;
}

.connection--ok .connection__dot {
  background: #0f9757;
}

.connection--warn {
  color: #9a6212;
}

.connection--warn .connection__dot {
  background: #c68a27;
}

.home-state {
  margin: 0 24rpx;
}

/* ============================================================
   十列横向滚动表格（spec 010 v1.2 / design §7.1）
   列宽（rpx）：股票 220 + 现价 118 + 涨跌幅 128 + 股息率 150 + PE 118
              + 周线五列 116×5 = 580 → 表宽 1314
   WXSS 对 rpx 在 CSS 变量与 calc() 内的换算不可靠，故表宽写死并在此留档，
   改任一列宽必须同步改 .board-table 的 width。
   ============================================================ */

.board-shell {
  margin: 0 12rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--c-card);
  box-shadow: 0 2rpx 12rpx rgba(23, 24, 26, 0.04);
}

/* 双向滚动容器：横向看十列，纵向看多行；表头/首列的 sticky 都以它为参照 */
.board-scroll {
  height: calc(100vh - 280rpx);
  min-height: 460rpx;
}

.board-table {
  width: 1314rpx;
}

.board-head,
.board-row {
  display: flex;
  width: 100%;
}

/* 表头 sticky top：横向滚动时不跟随，纵向滚动时固定在容器顶部 */
.board-head {
  position: sticky;
  top: 0;
  z-index: 4;
  height: 78rpx;
  border-bottom: 1rpx solid var(--c-line);
  background: #fafbfc;
}

.board-row {
  border-bottom: 1rpx solid var(--c-line);
  background: var(--c-card);
  transition: background-color 0.15s ease;
}

.board-row:last-child {
  border-bottom: none;
}

.board-row--hover {
  background: #f7f8fa;
}

.board-row--expanded {
  background: #fffdfb;
}

.cell {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 0 6rpx;
  color: var(--c-text);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

/* 数值列右对齐：位数不同也能按小数点对齐比较 */
.cell--price,
.cell--change,
.cell--yield,
.cell--pe,
.cell--week {
  justify-content: flex-end;
}

.cell--head {
  justify-content: center;
  padding: 0 4rpx;
  color: var(--c-text-2);
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.25;
  text-align: center;
  font-variant-numeric: normal;
}

.cell--stock {
  width: 220rpx;
  padding: 0 8rpx 0 16rpx;
  justify-content: space-between;
}

.cell--price {
  width: 118rpx;
}

.cell--change {
  width: 128rpx;
}

.cell--yield {
  width: 150rpx;
}

.cell--pe {
  width: 118rpx;
}

/* 周线五列：60周 / 120周 / 周上 / 周中 / 周下 */
.cell--week {
  width: 116rpx;
}

.cell--emphasis {
  color: var(--c-primary);
  font-weight: 600;
}

/* 首列 sticky left：横向滚动时名称/代码/行业始终可见。
   必须带不透明背景，否则右侧列会从下面透出来。 */
.board-row .cell--stock {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--c-card);
}

.board-row--hover .cell--stock {
  background: #f7f8fa;
}

.board-row--expanded .cell--stock {
  background: #fffdfb;
}

/* 交叉单元格：同时 sticky top 与 left，压在所有单元格之上 */
.board-head .cell--stock {
  position: sticky;
  left: 0;
  z-index: 5;
  justify-content: flex-start;
  padding-left: 16rpx;
  background: #fafbfc;
}

.stock-main {
  flex: 1;
  min-width: 0;
  padding: 12rpx 0;
}

.stock-name {
  max-width: 150rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.stock-meta {
  max-width: 150rpx;
  margin-top: 6rpx;
  color: var(--c-text-3);
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
}

/* 行业：东财 f127 原文（如「银行Ⅱ」），缺失显示 -- */
.stock-industry {
  max-width: 150rpx;
  margin-top: 3rpx;
  color: var(--c-text-3);
  font-size: 18rpx;
}

.stock-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}

.stock-status {
  color: #9a6212;
  font-size: 17rpx;
}

.stock-arrow {
  color: var(--c-text-3);
  font-size: 30rpx;
  line-height: 1;
  transform: rotate(90deg);
  transition: transform 0.15s ease;
}

.stock-arrow--open {
  transform: rotate(-90deg);
}

/* 展开区 sticky left + 视口宽度：横向滚动时六档目标价始终完整可见 */
.target-panel {
  position: sticky;
  left: 0;
  z-index: 1;
  width: 726rpx;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--c-line);
  background: #fffdfb;
}

.target-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  color: var(--c-text-2);
  font-size: 22rpx;
  font-weight: 500;
}

.target-panel__hint {
  color: var(--c-text-3);
  font-size: 18rpx;
  font-weight: 400;
}

.target-grid {
  display: flex;
  flex-wrap: wrap;
}

.target-item {
  width: 31.333%;
  min-height: 116rpx;
  margin: 0 1% 12rpx;
  padding: 14rpx 8rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 12rpx;
  background: var(--c-card);
  text-align: center;
}

.target-item__label,
.target-item__value,
.target-item__flag {
  display: block;
}

.target-item__label {
  color: var(--c-text-3);
  font-size: 19rpx;
}

.target-item__value {
  margin-top: 7rpx;
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 600;
}

.target-item__flag {
  margin-top: 3rpx;
  color: var(--c-primary);
  font-size: 17rpx;
}

.target-item--reached {
  border-color: #efcfd1;
  background: var(--c-primary-soft);
}

.target-item--reached .target-item__label,
.target-item--reached .target-item__value {
  color: var(--c-primary);
}

.board-foot {
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--c-line);
  color: var(--c-text-3);
  font-size: 19rpx;
  line-height: 1.5;
}

.load-failed {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 64rpx;
  padding-bottom: 64rpx;
  text-align: center;
}

.load-failed__hint {
  margin: 16rpx 0 28rpx;
  line-height: 1.7;
}
