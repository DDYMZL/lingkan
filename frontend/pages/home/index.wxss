.home-page {
  padding-top: 24rpx;
}

.home-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 24rpx;
  padding: 4rpx 4rpx 20rpx;
}

.home-head__titles {
  min-width: 0;
}

.home-head__title {
  font-size: 36rpx;
  font-weight: 600;
}

.home-head__time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}

.home-head__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.head-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--c-line);
  border-radius: 28rpx;
  background: var(--c-card);
  color: var(--c-text-2);
  font-size: 22rpx;
}

.head-action--primary {
  border-color: var(--c-primary);
  background: var(--c-primary);
  color: #fff;
}

.head-action:active {
  opacity: 0.7;
}

.board-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 28rpx 14rpx;
  color: var(--c-text-3);
  font-size: 22rpx;
}

.connection {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.connection__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--c-text-3);
}

.connection--ok {
  color: #0f7a4a;
}

.connection--ok .connection__dot {
  background: #0f9757;
}

.connection--warn {
  color: #9a6212;
}

.connection--warn .connection__dot {
  background: #c68a27;
}

.home-state {
  margin: 0 24rpx;
}

.board-shell {
  margin: 0 16rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--c-card);
  box-shadow: 0 2rpx 12rpx rgba(23, 24, 26, 0.04);
}

.board-head {
  display: flex;
  height: 78rpx;
  border-bottom: 1rpx solid var(--c-line);
  background: #fafbfc;
}

.board-head-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
}

.board-body {
  height: calc(100vh - 254rpx);
  min-height: 480rpx;
}

.board-content {
  width: 1978rpx;
}

.board-row {
  display: flex;
  width: 1978rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--c-line);
  background: var(--c-card);
}

.board-row:last-child {
  border-bottom: none;
}

.board-cell {
  display: flex;
  justify-content: center;
  flex-direction: column;
}

.board-cell--head {
  color: var(--c-text-2);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
}

.stock-cell {
  position: sticky;
  left: 0;
  z-index: 3;
  flex-shrink: 0;
  width: 200rpx;
  padding: 0 20rpx;
  border-right: 1rpx solid var(--c-line);
  background: var(--c-card);
  box-shadow: 8rpx 0 12rpx rgba(23, 24, 26, 0.025);
}

.board-head .stock-cell {
  z-index: 4;
  align-items: flex-start;
  background: #fafbfc;
}

.stock-cell--body:active {
  background: #f7f8fa;
}

.stock-cell__name {
  max-width: 160rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.stock-cell__meta {
  margin-top: 7rpx;
  color: var(--c-text-3);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.stock-cell__status {
  margin-top: 5rpx;
  color: #9a6212;
  font-size: 18rpx;
}

.metrics-row {
  display: flex;
  flex-shrink: 0;
  width: 1778rpx;
}

.metrics-row--head {
  height: 78rpx;
}

.metrics-row--body {
  min-height: 112rpx;
}

.metric-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0 10rpx;
  color: var(--c-text);
  font-size: 25rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.metric-cell--price,
.metric-cell--change,
.metric-cell--yield {
  width: 150rpx;
}

.metric-cell--pe {
  width: 140rpx;
}

.metric-cell--target {
  width: 132rpx;
  font-size: 23rpx;
}

.metric-cell--emphasis {
  color: var(--c-primary);
  font-weight: 600;
}

.metric-cell--reached {
  margin: 16rpx 6rpx;
  padding: 0 4rpx;
  border-radius: 8rpx;
  background: var(--c-primary-soft);
  color: var(--c-primary);
  font-weight: 600;
}

.board-foot {
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--c-line);
  color: var(--c-text-3);
  font-size: 19rpx;
  line-height: 1.5;
}

.load-failed {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 64rpx;
  padding-bottom: 64rpx;
  text-align: center;
}

.load-failed__hint {
  margin: 16rpx 0 28rpx;
  line-height: 1.7;
}
