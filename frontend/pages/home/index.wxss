.hero {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, #b3272d 0%, #8e1f24 55%, #6d171b 100%);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(139, 31, 36, 0.22);
}

.hero__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hero__mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.hero__name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero__tagline {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
  letter-spacing: 0.5rpx;
}

.phase {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.18);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.phase__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.phase--live .phase__dot {
  background: #ffd66b;
  box-shadow: 0 0 0 6rpx rgba(255, 214, 107, 0.18);
}

.hero__market {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.mkrow {
  display: flex;
  align-items: flex-end;
}

.mk {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-right: 48rpx;
}

.mk--right {
  margin-right: 0;
  margin-left: auto;
  align-items: flex-end;
}

.mk__num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.mk__num.up {
  color: #ffb3b0;
}

.mk__num.down {
  color: #9ff0c4;
}

.mk__num.flat {
  color: rgba(255, 255, 255, 0.9);
}

.mk__label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
}

.bar {
  display: flex;
  height: 8rpx;
  margin-top: 20rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.14);
}

.bar__seg {
  height: 100%;
}

.bar__seg--up {
  background: #ffb3b0;
}

.bar__seg--flat {
  background: rgba(255, 255, 255, 0.5);
}

.bar__seg--down {
  background: #9ff0c4;
}

.hero__sync {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.hero__market--empty {
  padding-bottom: 8rpx;
}

.hero__empty-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hero__empty-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.5);
}

/* ---------- 区块标题 ---------- */
.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
}

.section__count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--c-text-3);
}

.section__actions {
  display: flex;
  gap: 28rpx;
}

.link {
  font-size: 24rpx;
  color: var(--c-primary);
}

.link:active {
  opacity: 0.6;
}

/* ---------- 自选列表 ---------- */
.stock-list {
  padding: 0 24rpx;
}

.stock {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.stock:last-child {
  border-bottom: none;
}

.stock--hover {
  background: #fafbfc;
}

.stock__main {
  flex: 1;
  min-width: 0;
}

.stock__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stock__name {
  max-width: 300rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.stock__meta {
  margin-top: 6rpx;
}

.stock__price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 150rpx;
}

.stock__price-num {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stock__price-chg {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.stock__time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}

.column-hint {
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--c-text-3);
}

/* ---------- 入口 ---------- */
.entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--c-card);
}

.entry--hover {
  background: #fafbfc;
}

.entry__arrow {
  font-size: 40rpx;
  color: var(--c-text-3);
  line-height: 1;
}
