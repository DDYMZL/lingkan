.lk-empty {
  padding: 96rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lk-empty__icon {
  font-size: 68rpx;
  opacity: 0.55;
  margin-bottom: 20rpx;
}

.lk-empty__text {
  font-size: 28rpx;
  color: #6b7075;
}

.lk-empty__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  line-height: 1.6;
}

.lk-empty__action {
  margin-top: 32rpx;
  height: 64rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  background: #b3272d;
  color: #fff;
  font-size: 26rpx;
}
